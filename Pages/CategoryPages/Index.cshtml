@page
@model Rus_Carmen_Lab2.Pages.CategoryPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].CategoryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].BookCategories)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Category) {
        <tr>
                <td>
                    <a asp-page="./Index" asp-route-id="@item.ID">
                        @Html.DisplayFor(modelItem => item.CategoryName)
                    </a>
                </td>
            <td>
                @Html.DisplayFor(model => item.BookCategories)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table> 

@if (Model.CategoryID != 0)
{
    <h3>Cărțile categoriei selectate</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Titlu</th>
                <th>Autor</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Authors.FullName</td>
                </tr>
            }
        </tbody>
    </table>
}

